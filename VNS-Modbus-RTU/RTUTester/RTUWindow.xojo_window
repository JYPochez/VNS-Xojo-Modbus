#tag Events ButtonRefreshPorts
	#tag Event
		Sub Pressed()
		  Var selected As String
		  If PopupPort.SelectedRowIndex >= 0 Then selected = PopupPort.SelectedRowText
		  FillPorts(selected)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonOpen
	#tag Event
		Sub Pressed()
		  If RTUClient.State = ModbusTypes.eConnectionState.Connected Then
		    RTUClient.Disconnect
		  Else
		    If PopupPort.SelectedRowIndex < 0 Then
		      LabelStatus.Text = kErrorNoPort
		      Return
		    End If
		    ApplySettings
		    RTUClient.Connect
		  End If
		  UpdateConnectionState
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events PopupFunction
	#tag Event
		Sub SelectionChanged(item As DesktopMenuItem)
		  #Pragma Unused item
		  UpdateFieldStates
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonSend
	#tag Event
		Sub Pressed()
		  ApplySettings
		  Var failure As String
		  Var request As ModbusRequest = BuildRequest(failure)
		  If request Is Nil Then
		    LabelStatus.Text = failure
		    AddLog(kLogFailed + kSeparator + failure)
		    Return
		  End If
		  AddLog(kLogSent + kSeparator + PopupFunction.SelectedRowText + kSeparator + kLabelAddress + " " + request.Address.ToString)
		  RTUClient.Send(request)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonCopyLog
	#tag Event
		Sub Pressed()
		  Var board As New Clipboard
		  board.Text = ReportText
		  board.Close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonSaveLog
	#tag Event
		Sub Pressed()
		  #Pragma BreakOnExceptions Off
		  Var file As FolderItem = FolderItem.ShowSaveFileDialog("", kLogFileName)
		  If file Is Nil Then Return
		  Try
		    Var output As TextOutputStream = TextOutputStream.Create(file)
		    output.Encoding = Encodings.UTF8
		    output.Write(ReportText)
		    output.Close
		  Catch err As IOException
		    LabelStatus.Text = err.Message
		  End Try
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonClearLog
	#tag Event
		Sub Pressed()
		  mLog.RemoveAll
		  ListTrace.RemoveAllRows
		  ListResults.RemoveAllRows
		  LabelStatus.Text = ""
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events RTUClient
	#tag Event
		Sub Connected()
		  UpdateConnectionState
		  AddLog(kLogOpened + " " + SettingsText)
		End Sub
	#tag EndEvent
	#tag Event
		Sub Disconnected(reason As ModbusTypes.eError)
		  UpdateConnectionState
		  If reason = ModbusTypes.eError.None Then
		    AddLog(kLogClosed)
		  Else
		    LabelStatus.Text = ModbusTypes.ErrorText(reason) + ": " + Me.LastErrorMessage
		    AddLog(kLogFailed + kSeparator + LabelStatus.Text)
		  End If
		End Sub
	#tag EndEvent
	#tag Event
		Sub FrameTraced(sent As Boolean, frame As MemoryBlock)
		  Var direction As String = If(sent, kTX, kRX)
		  Var frameHex As String = HexText(frame)
		  ListTrace.AddRow(ElapsedText, direction, frameHex)
		  ListTrace.ScrollPosition = ListTrace.LastRowIndex
		  AddLog(direction + kSeparator + frameHex)
		End Sub
	#tag EndEvent
	#tag Event
		Sub RequestCompleted(request As ModbusRequest)
		  ShowResult(request)
		  If request.FunctionCode = ModbusTypes.eFunction.EncapsulatedInterface And request.MoreFollows Then
		    ' The device has more objects: ask for the rest.
		    AddLog(kLogMoreObjects + " " + request.NextObjectID.ToString)
		    Me.ReadDeviceIdentification(request.DeviceIDCategory, request.NextObjectID, Nil, kTagContinue)
		  End If
		  Var milliseconds As Integer = Round(request.ResponseTimeMS)
		  LabelStatus.Text = kLogOK + " (" + milliseconds.ToString + " ms)"
		  AddLog(kLogOK + kSeparator + milliseconds.ToString + " ms")
		End Sub
	#tag EndEvent
	#tag Event
		Sub RequestFailed(request As ModbusRequest)
		  ListResults.RemoveAllRows
		  LabelStatus.Text = request.ErrorMessage
		  AddLog(kLogFailed + kSeparator + request.ErrorMessage)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag ViewBehavior
#tag EndViewBehavior
