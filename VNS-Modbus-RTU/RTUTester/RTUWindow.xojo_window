#tag WindowCode
	#tag Event
		Sub Closing()
		  StoreSettings
		  RTUClient.Close
		End Sub
	#tag EndEvent

	#tag Event
		Sub Opening()
		  mStartMicroseconds = System.Microseconds
		  mSettings = RTUSettings.Load

		  FillPorts(mSettings.PortName)
		  For Each rate As String In kBaudRates.Split(",")
		    PopupBaud.AddRow(rate)
		    If rate.ToInteger = mSettings.BaudRate Then PopupBaud.SelectedRowIndex = PopupBaud.LastAddedRowIndex
		  Next
		  If PopupBaud.SelectedRowIndex < 0 Then PopupBaud.SelectedRowIndex = 5
		  For Each frameFormat As String In kFormats.Split(",")
		    PopupFormat.AddRow(frameFormat)
		    If frameFormat = mSettings.FrameFormat Then PopupFormat.SelectedRowIndex = PopupFormat.LastAddedRowIndex
		  Next
		  If PopupFormat.SelectedRowIndex < 0 Then PopupFormat.SelectedRowIndex = 0

		  AddFunction(kFunction01, 1)
		  AddFunction(kFunction02, 2)
		  AddFunction(kFunction03, 3)
		  AddFunction(kFunction04, 4)
		  AddFunction(kFunction05, 5)
		  AddFunction(kFunction06, 6)
		  AddFunction(kFunction08, 8)
		  AddFunction(kFunction15, 15)
		  AddFunction(kFunction16, 16)
		  AddFunction(kFunction17, 17)
		  AddFunction(kFunction22, 22)
		  AddFunction(kFunction23, 23)
		  AddFunction(kFunction43, 43)
		  If PopupFunction.SelectedRowIndex < 0 Then PopupFunction.SelectedRowIndex = 2

		  TextUnit.Text = mSettings.UnitID.ToString
		  TextTimeout.Text = mSettings.TimeoutMS.ToString
		  CheckEcho.Value = mSettings.SuppressEcho
		  TextAddress.Text = mSettings.Address.ToString
		  TextCount.Text = mSettings.Count.ToString
		  TextValues.Text = mSettings.Values
		  TextWriteAddress.Text = mSettings.WriteAddress.ToString

		  ListResults.HeaderAt(0) = kHeaderAddress
		  ListResults.HeaderAt(1) = kHeaderValue
		  ListResults.HeaderAt(2) = kHeaderHex
		  ListResults.HeaderAt(3) = kHeaderSigned
		  ListTrace.HeaderAt(0) = kHeaderTime
		  ListTrace.HeaderAt(1) = kHeaderDirection
		  ListTrace.HeaderAt(2) = kHeaderFrame

		  UpdateFieldStates
		  UpdateConnectionState
		  AddLog(kLogStarted)
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h21
		Private Sub AddFunction(caption As String, code As Integer)
		  PopupFunction.AddRow(caption)
		  PopupFunction.RowTagAt(PopupFunction.LastAddedRowIndex) = code
		  If code = mSettings.FunctionCode Then PopupFunction.SelectedRowIndex = PopupFunction.LastAddedRowIndex
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub AddLog(line As String)
		  mLog.Add(ElapsedText + kSeparator + line)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub ApplySettings()
		  ' The port, speed and format take effect when the port is opened.
		  If PopupPort.SelectedRowIndex >= 0 Then RTUClient.PortName = PopupPort.SelectedRowText
		  RTUClient.BaudRate = PopupBaud.SelectedRowText.ToInteger

		  ' Format: data bits, parity (N / E / O), stop bits, for example 8E1.
		  Var frameFormat As String = PopupFormat.SelectedRowText
		  RTUClient.DataBits = frameFormat.Left(1).ToInteger
		  Select Case frameFormat.Middle(1, 1)
		  Case kParityEven
		    RTUClient.Parity = SerialConnection.Parities.Even
		  Case kParityOdd
		    RTUClient.Parity = SerialConnection.Parities.Odd
		  Else
		    RTUClient.Parity = SerialConnection.Parities.None
		  End Select
		  RTUClient.StopBit = If(frameFormat.Right(1) = kStopTwo, SerialConnection.StopBits.Two, SerialConnection.StopBits.One)

		  RTUClient.UnitID = TextUnit.Text.ToInteger
		  RTUClient.TimeoutMS = Max(50, TextTimeout.Text.ToInteger)
		  RTUClient.SuppressEcho = CheckEcho.Value
		  StoreSettings
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function BuildRequest(ByRef failure As String) As ModbusRequest
		  ' Builds the request described by the fields; failure explains why when it returns Nil.
		  #Pragma BreakOnExceptions Off
		  Var code As Integer = PopupFunction.RowTagAt(PopupFunction.SelectedRowIndex).IntegerValue
		  Var address As Integer = TextAddress.Text.ToInteger
		  Var count As Integer = TextCount.Text.ToInteger

		  Var values() As UInt16
		  If NeedsValues(code) Then
		    failure = ParseValues(TextValues.Text, values)
		    If failure = "" And values.Count = 0 Then failure = kErrorNoValues
		    If failure <> "" Then Return Nil
		  End If
		  If code = 5 Or code = 15 Then
		    ' Coils: any value other than 0 means ON.
		    For i As Integer = 0 To values.LastIndex
		      If values(i) <> 0 Then values(i) = 1
		    Next
		  End If

		  Var request As ModbusRequest
		  Try
		    Select Case code
		    Case 1, 2, 3, 4
		      request = New ModbusRequest(ModbusTypes.eFunction(code), address, count)
		    Case 5, 6
		      Var firstValue() As UInt16
		      firstValue.Add(values(0))
		      request = New ModbusRequest(ModbusTypes.eFunction(code), address, firstValue)
		    Case 15, 16
		      request = New ModbusRequest(ModbusTypes.eFunction(code), address, values)
		    Case 23
		      request = New ModbusRequest(address, count, TextWriteAddress.Text.ToInteger, values)
		    Case 8
		      request = ModbusRequest.ReturnQueryData(values(0))
		    Case 17
		      request = ModbusRequest.ReportServerID
		    Case 22
		      If values.Count < 2 Then
		        failure = kErrorTwoMasks
		      Else
		        request = ModbusRequest.MaskWrite(address, values(0), values(1))
		      End If
		    Case 43
		      ' Count = category (1 basic to 4 one object), Address = first object
		      request = ModbusRequest.ReadDeviceIdentification(count, address)
		    End Select
		  Catch err As InvalidArgumentException
		    failure = err.Message
		  End Try
		  #Pragma BreakOnExceptions Off
		  Return request
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ElapsedText() As String
		  Var seconds As Double = (System.Microseconds - mStartMicroseconds) / 1000000.0
		  Return seconds.ToString(Locale.Raw, "0.000")
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub FillPorts(selected As String)
		  PopupPort.RemoveAllRows
		  For Each portName As String In ModbusRTUClient.PortNames
		    PopupPort.AddRow(portName)
		    If portName = selected Then PopupPort.SelectedRowIndex = PopupPort.LastAddedRowIndex
		  Next
		  If PopupPort.SelectedRowIndex < 0 And PopupPort.RowCount > 0 Then PopupPort.SelectedRowIndex = 0
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function HexText(frame As MemoryBlock) As String
		  Var parts() As String
		  For i As Integer = 0 To frame.Size - 1
		    Var b As Integer = frame.UInt8Value(i)
		    parts.Add(b.ToHex(2))
		  Next
		  Return String.FromArray(parts, " ")
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function NeedsValues(code As Integer) As Boolean
		  Select Case code
		  Case 5, 6, 8, 15, 16, 22, 23
		    Return True
		  Else
		    Return False
		  End Select
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ObjectName(objectID As Integer) As String
		  Select Case objectID
		  Case 0
		    Return kObjectVendor
		  Case 1
		    Return kObjectProductCode
		  Case 2
		    Return kObjectRevision
		  Case 3
		    Return kObjectVendorURL
		  Case 4
		    Return kObjectProductName
		  Case 5
		    Return kObjectModel
		  Case 6
		    Return kObjectApplication
		  Else
		    Return kObjectOther + " " + objectID.ToString
		  End Select
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ParseValues(text As String, values() As UInt16) As String
		  ' Decimal or 0x hex, separated by commas, semicolons or spaces; -32768 to 65535.
		  Var cleaned As String = text.ReplaceAll(";", ",").ReplaceAll(" ", ",")
		  For Each token As String In cleaned.Split(",")
		    Var item As String = token.Trim
		    If item = "" Then Continue
		    Var number As Integer
		    If item.Left(2).Lowercase = kHexPrefix Then
		      Var digits As String = item.Middle(2)
		      If digits = "" Then Return kErrorBadValue + " " + item
		      number = Integer.FromHex(digits)
		    Else
		      Var body As String = If(item.Left(1) = "-", item.Middle(1), item)
		      If body = "" Then Return kErrorBadValue + " " + item
		      For Each character As String In body.Characters
		        If kDigits.IndexOf(character) < 0 Then Return kErrorBadValue + " " + item
		      Next
		      number = item.ToInteger
		    End If
		    If number < -32768 Or number > 65535 Then Return kErrorBadValue + " " + item
		    If number < 0 Then number = number + 65536
		    values.Add(number)
		  Next
		  Return ""
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ReportText() As String
		  ' Everything a tester needs to send back: versions, platform, settings and the log.
		  Var lines() As String
		  lines.Add(kReportTitle)
		  lines.Add(kReportVersion + " " + App.MajorVersion.ToString + "." + App.MinorVersion.ToString + "." + App.BugVersion.ToString)
		  lines.Add(kReportLibrary + " " + ModbusTypes.kVersion)
		  #If TargetMacOS Then
		    lines.Add(kReportPlatform + " " + kPlatformMac)
		  #ElseIf TargetWindows Then
		    lines.Add(kReportPlatform + " " + kPlatformWindows)
		  #Else
		    lines.Add(kReportPlatform + " " + kPlatformLinux)
		  #EndIf
		  lines.Add(kReportSettings + " " + SettingsText)
		  lines.Add("")
		  For Each line As String In mLog
		    lines.Add(line)
		  Next
		  Return String.FromArray(lines, EndOfLine)
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function SettingsText() As String
		  Var parts() As String
		  parts.Add(RTUClient.PortName)
		  parts.Add(RTUClient.BaudRate.ToString)
		  parts.Add(PopupFormat.SelectedRowText)
		  parts.Add(kLabelUnit + " " + RTUClient.UnitID.ToString)
		  parts.Add(kLabelTimeout + " " + RTUClient.TimeoutMS.ToString)
		  If RTUClient.SuppressEcho Then parts.Add(kCheckEcho)
		  Return String.FromArray(parts, ", ")
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub ShowResult(request As ModbusRequest)
		  ' A continuation of FC 43 adds its objects to the ones already shown.
		  If request.Tag.StringValue <> kTagContinue Then ListResults.RemoveAllRows
		  
		  Select Case request.FunctionCode
		  Case ModbusTypes.eFunction.EncapsulatedInterface
		    For Each entry As DictionaryEntry In request.DeviceObjects
		      Var objectID As Integer = entry.Key.IntegerValue
		      ListResults.AddRow(ObjectName(objectID), entry.Value.StringValue)
		    Next
		    Return
		  Case ModbusTypes.eFunction.ReportServerID
		    For i As Integer = 0 To request.ResponseBytes.Size - 1
		      Var b As Integer = request.ResponseBytes.UInt8Value(i)
		      Var character As String = If(b >= 32 And b < 127, String.Chr(b), "")
		      ListResults.AddRow(i.ToString, b.ToString, kHexPrefix + b.ToHex(2), character)
		    Next
		    Return
		  Case ModbusTypes.eFunction.Diagnostics
		    Var echoed As Integer = request.Values(0)
		    ListResults.AddRow(kLoopbackOK, echoed.ToString, kHexPrefix + echoed.ToHex(4))
		    Return
		  End Select
		  
		  If request.IsWrite Then
		    ListResults.AddRow(request.Address.ToString, kWriteAccepted)
		    Return
		  End If
		  For i As Integer = 0 To request.Values.LastIndex
		    Var registerAddress As Integer = request.Address + i
		    Var value As Integer = request.Values(i)
		    Var signedValue As Integer = ModbusTypes.ToSigned16(value)
		    ListResults.AddRow(registerAddress.ToString, value.ToString, kHexPrefix + value.ToHex(4), signedValue.ToString)
		  Next
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub StoreSettings()
		  If mSettings Is Nil Then Return
		  If PopupPort.SelectedRowIndex >= 0 Then mSettings.PortName = PopupPort.SelectedRowText
		  mSettings.BaudRate = PopupBaud.SelectedRowText.ToInteger
		  mSettings.FrameFormat = PopupFormat.SelectedRowText
		  mSettings.UnitID = TextUnit.Text.ToInteger
		  mSettings.TimeoutMS = TextTimeout.Text.ToInteger
		  mSettings.SuppressEcho = CheckEcho.Value
		  If PopupFunction.SelectedRowIndex >= 0 Then mSettings.FunctionCode = PopupFunction.RowTagAt(PopupFunction.SelectedRowIndex).IntegerValue
		  mSettings.Address = TextAddress.Text.ToInteger
		  mSettings.Count = TextCount.Text.ToInteger
		  mSettings.Values = TextValues.Text
		  mSettings.WriteAddress = TextWriteAddress.Text.ToInteger
		  mSettings.Save
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UpdateConnectionState()
		  Var isOpen As Boolean = (RTUClient.State = ModbusTypes.eConnectionState.Connected)
		  ButtonOpen.Caption = If(isOpen, kButtonClose, kButtonOpen)
		  LabelState.Text = If(isOpen, kStateOpen, kStateClosed)
		  ' Port settings apply when the port opens: lock them while it is open.
		  PopupPort.Enabled = Not isOpen
		  ButtonRefreshPorts.Enabled = Not isOpen
		  PopupBaud.Enabled = Not isOpen
		  PopupFormat.Enabled = Not isOpen
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UpdateFieldStates()
		  If PopupFunction.SelectedRowIndex < 0 Then Return
		  Var code As Integer = PopupFunction.RowTagAt(PopupFunction.SelectedRowIndex).IntegerValue
		  TextCount.Enabled = (code <= 4 Or code = 23 Or code = 43)
		  TextValues.Enabled = NeedsValues(code)
		  TextWriteAddress.Enabled = (code = 23)
		  TextAddress.Enabled = (code <> 8 And code <> 17)
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h21
		Private mLog() As String
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mSettings As RTUSettings
	#tag EndProperty

	#tag Property, Flags = &h21
