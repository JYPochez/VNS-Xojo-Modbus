#tag WindowCode
	#tag Method, Flags = &h21
		Private Function IsNumber(text As String) As Boolean
		  ' Accepts an optional minus sign, digits and at most one decimal point.
		  If text = "" Then Return False
		  Var seenDigit, seenPoint As Boolean
		  For i As Integer = 0 To text.Length - 1
		    Var character As String = text.Middle(i, 1)
		    If character = "-" And i = 0 Then Continue
		    If character = "." And Not seenPoint Then
		      seenPoint = True
		      Continue
		    End If
		    If kDigits.IndexOf(character) < 0 Then Return False
		    seenDigit = True
		  Next
		  Return seenDigit
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0, Description = 53686F777320746865206469616C6F6720666F722061207772697461626C6520706F696E742E2052657475726E732054727565207768656E20746865207573657220636F6E6669726D65643B207468652076616C7565206973207468656E20696E2043686F73656E56616C75652028656E67696E656572696E6720756E697473292E0A
		Function ShowFor(target As ModbusPoint, warning As String) As Boolean
		  mTarget = target
		  LabelPointName.Text = target.Label
		  Var location As String = ModbusTypes.AreaPrefix(target.Area) + target.Address.ToString
		  If target.WriteAddress >= 0 Then location = ModbusTypes.AreaPrefix(target.Area) + target.WriteAddress.ToString
		  LabelRegister.Text = kLabelRegister + " " + location
		  LabelCurrent.Text = kLabelCurrent + " " + target.DisplayText
		  LabelError.Text = ""
		  LabelWarning.Text = warning

		  If target.HasEnumLabels Then
		    ' Coded value: choose among the labels (within the allowed range).
		    TextValue.Visible = False
		    LabelRange.Visible = False
		    PopupChoice.Visible = True
		    Var current As Integer = target.RawValue
		    For Each rawValue As Integer In target.EnumValues
		      If target.MinValue < target.MaxValue And (rawValue < target.MinValue Or rawValue > target.MaxValue) Then Continue
		      PopupChoice.AddRow(target.EnumLabel(rawValue))
		      PopupChoice.RowTagAt(PopupChoice.LastAddedRowIndex) = rawValue
		      If target.HasValue And rawValue = current Then PopupChoice.SelectedRowIndex = PopupChoice.LastAddedRowIndex
		    Next
		    If PopupChoice.SelectedRowIndex < 0 And PopupChoice.RowCount > 0 Then PopupChoice.SelectedRowIndex = 0
		  Else
		    PopupChoice.Visible = False
		    TextValue.Visible = True
		    LabelRange.Visible = True
		    TextValue.Text = If(target.HasValue, target.FormattedValue, "")
		    If target.MinValue < target.MaxValue Then
		      LabelRange.Text = target.MinValue.ToString(Locale.Current, "0.###") + kRangeSeparator _
		      + target.MaxValue.ToString(Locale.Current, "0.###") + " " + target.Unit
		    Else
		      LabelRange.Text = target.Unit
		    End If
		  End If

		  mAccepted = False
		  Self.ShowModal
		  Return mAccepted
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ValidatedValue(ByRef chosen As Double) As Boolean
		  If PopupChoice.Visible Then
		    If PopupChoice.SelectedRowIndex < 0 Then Return False
		    Var rawValue As Integer = PopupChoice.RowTagAt(PopupChoice.SelectedRowIndex).IntegerValue
		    chosen = rawValue * mTarget.Scale + mTarget.ValueOffset
		    Return True
		  End If

		  ' Both decimal separators are accepted, whatever the user's locale.
		  Var text As String = TextValue.Text.Trim.ReplaceAll(",", ".")
		  If Not IsNumber(text) Then
		    LabelError.Text = kErrorNotNumber
		    Return False
		  End If
		  chosen = Double.Parse(text, Locale.Raw)
		  If mTarget.MinValue < mTarget.MaxValue And (chosen < mTarget.MinValue Or chosen > mTarget.MaxValue) Then
		    LabelError.Text = kErrorOutOfRange + " " + LabelRange.Text
		    Return False
		  End If
		  Return True
		End Function
	#tag EndMethod


	#tag Property, Flags = &h0, Description = 5468652076616C756520746F2077726974653B20696E20656E67696E656572696E6720756E697473202861667465722053686F77466F722072657475726E65642054727565292E0A
		ChosenValue As Double
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mAccepted As Boolean
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mTarget As ModbusPoint
	#tag EndProperty


	#tag Constant, Name = kButtonCancel, Type = String, Dynamic = False, Default = \"Cancel", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kButtonWrite, Type = String, Dynamic = False, Default = \"Write", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kDigits, Type = String, Dynamic = False, Default = \"0123456789", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kErrorNotNumber, Type = String, Dynamic = False, Default = \"Enter a number.", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kErrorOutOfRange, Type = String, Dynamic = False, Default = \"Allowed range:", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kLabelCurrent, Type = String, Dynamic = False, Default = \"Current value:", Scope = Private
	#tag EndConstant

