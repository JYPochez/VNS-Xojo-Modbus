	#tag EndConstant

	#tag Constant, Name = kRangeSeparator, Type = String, Dynamic = False, Default = \" to ", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kWindowTitle, Type = String, Dynamic = False, Default = \"Write to the heat pump", Scope = Private
	#tag EndConstant

#tag EndWindowCode

#tag Events ButtonCancel
	#tag Event
		Sub Pressed()
		  mAccepted = False
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonWrite
	#tag Event
		Sub Pressed()
		  Var chosen As Double
		  If Not ValidatedValue(chosen) Then Return
		  ChosenValue = chosen
		  mAccepted = True
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events LabelError
	#tag Event
		Sub Opening()
		  Me.TextColor = Color.Red
		End Sub
	#tag EndEvent
#tag EndEvents
#tag ViewBehavior
#tag EndViewBehavior
