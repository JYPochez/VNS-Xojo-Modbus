#tag Events ButtonConnect
	#tag Event
		Sub Pressed()
		  If HeatPumpClient.State = ModbusTypes.eConnectionState.Disconnected And HeatPumpPoller.RunMode = Timer.RunModes.Off Then
		    HeatPumpClient.Address = TextAddress.Text.Trim
		    Var portNumber As Integer = TextPort.Text.ToInteger
		    If portNumber <= 0 Then portNumber = ModbusTypes.kDefaultPort
		    HeatPumpClient.Port = portNumber
		    HeatPumpClient.UnitID = TextUnit.Text.ToInteger
		    mSettings.Address = HeatPumpClient.Address
		    mSettings.Port = portNumber
		    mSettings.UnitID = HeatPumpClient.UnitID
		    mSettings.Save
		    HeatPumpClient.Connect
		    HeatPumpPoller.Start
		  Else
		    HeatPumpPoller.Stop
		    HeatPumpClient.Disconnect
		  End If
		  UpdateConnectionState
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events CheckControl
	#tag Event
		Sub ValueChanged()
		  If mChangingControl Then Return
		  If Me.Value Then
		    ' Writing changes a real heat pump: ask once per session.
		    Var dialog As New MessageDialog
		    dialog.Title = kControlTitle
		    dialog.Message = kControlMessage
		    dialog.Explanation = kControlExplanation
		    dialog.ActionButton.Caption = kControlEnable
		    dialog.CancelButton.Visible = True
		    If dialog.ShowModal <> dialog.ActionButton Then
		      mChangingControl = True
		      Me.Value = False
		      mChangingControl = False
		      Return
		    End If
		  End If
		  mShownSection = ""
		  RefreshPoints
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ListPoints
	#tag Event
		Sub DoublePressed()
		  EditSelectedPoint
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ListSections
	#tag Event
		Sub SelectionChanged()
		  If mRebuildingSections Then Return
		  RefreshPoints
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events HeatPumpClient
	#tag Event
		Sub Connected()
		  UpdateConnectionState
		End Sub
	#tag EndEvent
	#tag Event
		Sub Disconnected(reason As ModbusTypes.eError)
		  UpdateConnectionState
		  If reason <> ModbusTypes.eError.None Then
		    LabelStatus.Text = ModbusTypes.ErrorText(reason) + kLabelSeparator + Me.LastErrorMessage
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events HeatPumpPoller
	#tag Event
		Sub PointsUpdated()
		  RefreshSections
		  RefreshPoints
		  UpdateStatusStrip
		End Sub
	#tag EndEvent
	#tag Event
		Sub PollFailed(request As ModbusRequest)
		  LabelStatus.Text = request.ErrorMessage
		End Sub
	#tag EndEvent
	#tag Event
		Sub WriteCompleted(target As ModbusPoint, succeeded As Boolean, message As String)
		  If succeeded Then
		    mLastWriteMessage = target.Label + kLabelSeparator + kWriteDone
		  Else
		    mLastWriteMessage = target.Label + kLabelSeparator + kWriteFailed + " " + message
		  End If
		  UpdateStatusStrip
		End Sub
	#tag EndEvent
#tag EndEvents
#tag ViewBehavior
#tag EndViewBehavior
