#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Closing()
		  HeatPumpPoller.Stop
		  HeatPumpClient.Close
		  
		  mSettings.Section = SelectedSection
		  mSettings.WindowWidth = Self.Width
		  mSettings.WindowHeight = Self.Height
		  mSettings.Save
		End Sub
	#tag EndEvent

	#tag Event
		Sub Opening()
		  mSettings = AirH2OSettings.Load
		  TextAddress.Text = mSettings.Address
		  TextPort.Text = mSettings.Port.ToString
		  TextUnit.Text = mSettings.UnitID.ToString
		  HeatPumpPoller.Period = Max(1000, mSettings.PollPeriodMS)
		  If mSettings.WindowWidth >= Self.MinimumWidth And mSettings.WindowHeight >= Self.MinimumHeight Then
		    Self.Width = mSettings.WindowWidth
		    Self.Height = mSettings.WindowHeight
		  End If

		  ListPoints.HeaderAt(0) = kHeaderLabel
		  ListPoints.HeaderAt(1) = kHeaderValue
		  ListPoints.HeaderAt(2) = kHeaderRegister
		  ListPoints.HeaderAt(3) = kHeaderRaw

		  ' The whole device is described by the point table; the poller reads it in a few blocks.
		  HeatPumpPoller.Client = HeatPumpClient
		  For Each p As ModbusPoint In AirH2OPoints.CreatePoints
		    HeatPumpPoller.AddPoint(p)
		  Next

		  RefreshSections
		  SelectSection(mSettings.Section)
		  UpdateConnectionState
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h21
		Private Sub EditSelectedPoint()
		  ' The single write path of the app: control enabled -> writable point -> connected ->
		  ' H-LINK OK -> dialog (with warnings) -> WritePoint (range check, FC06, re-read).
		  #Pragma BreakOnExceptions Off
		  If Not CheckControl.Value Then Return
		  Var row As Integer = ListPoints.SelectedRowIndex
		  If row < 0 Then Return
		  Var target As ModbusPoint = ModbusPoint(ListPoints.RowTagAt(row))
		  If Not target.IsWritable Then Return
		  
		  If HeatPumpClient.State <> ModbusTypes.eConnectionState.Connected Then
		    MessageBox(kWriteNotConnected)
		    Return
		  End If
		  
		  Var hlink As ModbusPoint = HeatPumpPoller.FindPoint(AirH2OPoints.kPointHLink)
		  If hlink <> Nil And hlink.HasValue And hlink.RawValue <> AirH2OPoints.kHLinkOK Then
		    MessageBox(kWriteHLinkBlocked + " " + hlink.DisplayText)
		    Return
		  End If
		  
		  Var warnings() As String
		  Var central As ModbusPoint = HeatPumpPoller.FindPoint(AirH2OPoints.kPointCentralMode)
		  If central <> Nil And central.HasValue And central.RawValue <> AirH2OPoints.kCentralFull Then
		    warnings.Add(kWarningCentralMode + " " + central.DisplayText)
		  End If
		  If AirH2OPoints.IsSensitive(target.Name) Then warnings.Add(kWarningSensitive)
		  
		  Var dialog As New WriteValueWindow
		  If Not dialog.ShowFor(target, String.FromArray(warnings, EndOfLine)) Then Return
		  
		  Var failure As String
		  Try
		    HeatPumpPoller.WritePoint(target.Name, dialog.ChosenValue)
		  Catch err As InvalidArgumentException
		    failure = err.Message
		  End Try
		  #Pragma BreakOnExceptions Off
		  If failure <> "" Then
		    MessageBox(failure)
		  Else
		    mLastWriteMessage = kWriting + " " + target.Label + kLabelSeparator + dialog.ChosenValue.ToString(Locale.Current, "0.###")
		    UpdateStatusStrip
		  End If
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function LocationText(p As ModbusPoint) As String
		  Var text As String = ModbusTypes.AreaPrefix(p.Area) + p.Address.ToString
		  If p.BitIndex >= 0 Then text = text + "." + p.BitIndex.ToString
		  Return text
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function RawText(p As ModbusPoint) As String
		  If Not p.HasValue Then Return ""
		  Var raw As Integer = p.RawValue
		  Return raw.ToString
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub RefreshPoints()
		  ' Rebuild the rows when the section changes; otherwise only update the values in place
		  ' so the selection and the scroll position stay where the user left them.
		  Var section As String = SelectedSection
		  If section <> mShownSection Then
		    ListPoints.RemoveAllRows
		    For Each p As ModbusPoint In HeatPumpPoller.Points
		      If section = kSectionAll Or AirH2OPoints.SectionOf(p.Name) = section Then
		        ' Read-only points carry a lock; the others can be written once control is enabled.
		        Var rowLabel As String = If(p.IsWritable, p.Label, kReadOnlyMark + p.Label)
		        ListPoints.AddRow(rowLabel, p.DisplayText, LocationText(p), RawText(p))
		        ListPoints.RowTagAt(ListPoints.LastAddedRowIndex) = p
		      End If
		    Next
		    mShownSection = section
		    Return
		  End If

		  For row As Integer = 0 To ListPoints.LastRowIndex
		    Var p As ModbusPoint = ModbusPoint(ListPoints.RowTagAt(row))
		    ListPoints.CellTextAt(row, 1) = p.DisplayText
		    ListPoints.CellTextAt(row, 3) = RawText(p)
		  Next
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub RefreshSections()
		  ' Show only the sections the unit has, once the System Configuration register is known.
		  Var config As ModbusPoint = HeatPumpPoller.FindPoint(AirH2OPoints.kPointConfig)
		  Var known As Boolean = config <> Nil And config.HasValue And config.IsValid
		  Var configValue As Integer
		  If known Then configValue = config.RawValue

		  Var keys() As String = Array(AirH2OPoints.kSectionSystem, AirH2OPoints.kSectionCircuit1, _
		  AirH2OPoints.kSectionCircuit2, AirH2OPoints.kSectionDHW, AirH2OPoints.kSectionPool, _
		  AirH2OPoints.kSectionServicing, AirH2OPoints.kSectionGateway)
		  Var visible() As String
		  For Each key As String In keys
		    If Not known Or AirH2OPoints.IsSectionFitted(key, configValue) Then visible.Add(key)
		  Next
		  visible.Add(kSectionAll)

		  Var signature As String = String.FromArray(visible, ",")
		  If signature = mSectionSignature Then Return
		  mSectionSignature = signature

		  Var previous As String = SelectedSection
		  mRebuildingSections = True
		  ListSections.RemoveAllRows
		  For Each key As String In visible
		    ListSections.AddRow(SectionTitle(key))
		    ListSections.RowTagAt(ListSections.LastAddedRowIndex) = key
		    If key = previous Then ListSections.SelectedRowIndex = ListSections.LastAddedRowIndex
		  Next
		  If ListSections.SelectedRowIndex < 0 Then ListSections.SelectedRowIndex = 0
		  mRebuildingSections = False

		  mShownSection = ""
		  RefreshPoints
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function SectionTitle(key As String) As String
		  Select Case key
		  Case AirH2OPoints.kSectionCircuit1
		    Return kTitleCircuit1
		  Case AirH2OPoints.kSectionCircuit2
		    Return kTitleCircuit2
		  Case AirH2OPoints.kSectionDHW
		    Return kTitleDHW
		  Case AirH2OPoints.kSectionPool
		    Return kTitlePool
		  Case AirH2OPoints.kSectionServicing
		    Return kTitleServicing
		  Case AirH2OPoints.kSectionGateway
		    Return kTitleGateway
		  Case kSectionAll
		    Return kTitleAll
		  Else
		    Return kTitleSystem
		  End Select
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub SelectSection(key As String)
		  For row As Integer = 0 To ListSections.LastRowIndex
		    If ListSections.RowTagAt(row).StringValue = key Then
		      ListSections.SelectedRowIndex = row
		      Return
		    End If
		  Next
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function SelectedSection() As String
		  Var row As Integer = ListSections.SelectedRowIndex
		  If row < 0 Then Return AirH2OPoints.kSectionSystem
		  Return ListSections.RowTagAt(row).StringValue
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UpdateConnectionState()
		  Var disconnected As Boolean = (HeatPumpClient.State = ModbusTypes.eConnectionState.Disconnected)
		  ButtonConnect.Caption = If(disconnected And HeatPumpPoller.RunMode = Timer.RunModes.Off, kButtonConnect, kButtonDisconnect)
		  TextAddress.Enabled = disconnected
		  TextPort.Enabled = disconnected
		  TextUnit.Enabled = disconnected

		  Select Case HeatPumpClient.State
		  Case ModbusTypes.eConnectionState.Connected
		    LabelConnection.Text = kStateConnected
		  Case ModbusTypes.eConnectionState.Connecting
		    LabelConnection.Text = kStateConnecting
		  Else
		    ' Still polling while disconnected: the client is waiting to reconnect.
		    LabelConnection.Text = If(HeatPumpPoller.RunMode = Timer.RunModes.Off, kStateDisconnected, kStateRetrying)
		  End Select
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UpdateStatusStrip()
		  Var parts() As String
		  If mLastWriteMessage <> "" Then parts.Add(mLastWriteMessage)
		  For Each pointName As String In kStatusPoints.Split(",")
		    Var p As ModbusPoint = HeatPumpPoller.FindPoint(pointName)
		    If p <> Nil And p.HasValue Then parts.Add(p.Label + kLabelSeparator + p.DisplayText)
		  Next
		  Var stamp As DateTime = DateTime.Now
		  parts.Add(kStatusUpdated + " " + stamp.ToString(Locale.Current, DateTime.FormatStyles.None, DateTime.FormatStyles.Medium))
		  LabelStatus.Text = String.FromArray(parts, kStatusSeparator)
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h21
		Private mChangingControl As Boolean
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mLastWriteMessage As String
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mRebuildingSections As Boolean
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mSectionSignature As String
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mSettings As AirH2OSettings
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mShownSection As String
	#tag EndProperty


