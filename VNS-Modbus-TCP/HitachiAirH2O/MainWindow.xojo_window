	#tag EndConstant

	#tag Constant, Name = kButtonDisconnect, Type = String, Dynamic = False, Default = \"Disconnect", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kCheckControl, Type = String, Dynamic = False, Default = \"Enable control", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kControlEnable, Type = String, Dynamic = False, Default = \"Enable control", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kControlExplanation, Type = String, Dynamic = False, Default = \"Double-click a line without a lock to change its value. Each change is sent to the unit at once. Lines with a lock are read-only.", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kControlMessage, Type = String, Dynamic = False, Default = \"Allow changes to the heat pump settings?", Scope = Private
	#tag EndConstant

